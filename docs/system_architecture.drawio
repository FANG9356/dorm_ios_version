        </mxCell>

        <!-- Ingress 2: LINE LIFF to Cloudflare Tunnel -->
        <mxCell id="flow_liff_to_cf" value="HTTPS / WSS (REST APIs &amp; Slip Uploads)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.3;exitY=1;exitDx=0;exitDy=0;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="1" source="liff_app_container" target="cf_tunnel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway 3: Cloudflare Tunnel to Go Backend -->
        <mxCell id="flow_cf_to_go" value="Reverse Proxy (HTTP :4283)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.6;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#fb923c;strokeWidth=2;fontColor=#fb923c;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="tier2_container" source="cf_tunnel" target="go_backend_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Internal Microservice: Go Backend to OCR Bot -->
        <mxCell id="flow_go_to_ocr" value="Local IPC (HTTP 127.0.0.1:5001)&#xa;Slip Image Verification Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#c084fc;strokeWidth=2;fontColor=#c084fc;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="tier2_container" source="go_backend_container" target="ocr_service_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cloud Integration: Go Backend to External APIs -->
        <mxCell id="flow_go_to_ext" value="HTTPS Outbound&#xa;Webhooks &amp; Push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.8;exitDx=0;exitDy=0;strokeColor=#94a3b8;strokeWidth=2;fontColor=#cbd5e1;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="tier2_container" source="ocr_service_container" target="external_gateways_container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data Flow: Go Backend to Master DB -->
        <mxCell id="flow_go_to_master_db" value="SQLite WAL Connection (database/sql)&#xa;Auth, Snapshot &amp; Identity Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;strokeColor=#818cf8;strokeWidth=2;fontColor=#818cf8;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="1" source="go_backend_container" target="db_master_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data Flow: Go Backend to Tenant DBs -->
        <mxCell id="flow_go_to_tenant_db" value="Dynamic SQLite Pool (tenant_helper.go)&#xa;Isolated File-per-Tenant Operations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.65;exitY=1;exitDx=0;exitDy=0;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="1" source="go_backend_container" target="db_tenant_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data Flow: Go Backend to Upload Storage -->
        <mxCell id="flow_go_to_storage" value="File I/O Stream (Slips &amp; Photos)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.9;exitY=1;exitDx=0;exitDy=0;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontSize=11;fontStyle=1;labelBackgroundColor=#0b0f19;" edge="1" parent="1" source="go_backend_container" target="storage_uploads_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
