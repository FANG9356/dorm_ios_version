#!/usr/bin/expect -f
set timeout 10
set password "2550"
spawn ssh fang@202.29.232.28
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r" }
}
expect "$ "
send "echo $password | sudo -S sqlite3 /opt/dormitory/dormitory.db '.schema admins' > /tmp/schema.txt\r"
expect "$ "
send "cat /tmp/schema.txt\r"
expect "$ "
send "exit\r"
expect eof
