#!/usr/bin/expect -f

set timeout 30
set password "2550"
set host "202.29.232.28"
set user "fang"

# 1. Stop service
spawn ssh $user@$host "echo $password | sudo -S systemctl stop dormitory"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    eof
}

# 2. Upload file
spawn scp /Volumes/FangB/dorm_project/backend-dorm/server_debian $user@$host:/opt/dormitory/server_debian
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    eof
}

# 3. Start service
spawn ssh $user@$host "echo $password | sudo -S systemctl start dormitory"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    eof
}

puts "Deployment Complete!"
