#!/usr/bin/expect -f

set timeout 120
set password "2550"
set host "202.29.232.28"
set user "fang"

# 1. Stop service
spawn ssh $user@$host "echo $password | sudo -S systemctl stop dormitory"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    eof
}

# 2. Upload source tarball
spawn scp /tmp/backend-src.tar.gz $user@$host:/home/fang/backend-src.tar.gz
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    eof
}

# 3. Build on server
spawn ssh $user@$host "cd /home/fang && rm -rf backend-build && mkdir -p backend-build && cd backend-build && tar xzf /home/fang/backend-src.tar.gz && CGO_ENABLED=1 /usr/local/go/bin/go build -o server_debian . && echo $password | sudo -S cp server_debian /opt/dormitory/server_debian && echo BUILD_SUCCESS"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    "BUILD_SUCCESS" { puts "\nBuild successful!" }
    eof
}

# 4. Start service
spawn ssh $user@$host "echo $password | sudo -S systemctl start dormitory"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "*?assword:*" { send "$password\r"; exp_continue }
    eof
}

puts "Deployment Complete!"
