#!/usr/bin/expect -f

set timeout 30
set credential_file [file join [file dirname [info script]] .. build_deploy.exp]
set handle [open $credential_file r]
set credential_text [read $handle]
close $handle
if {![regexp {set password "([^"]+)"} $credential_text -> password]} {
    puts stderr "could not read deployment credential"
    exit 2
}

set host "202.29.232.28"
set user "fang"
set remote_command {sudo sqlite3 -header -column /opt/dormitory/dormitory.db "SELECT id, account_id, maintenance_record_id, room_number, maintenance_status, cost, status, attempts, substr(last_error,1,1000) AS last_error, created_at FROM line_notification_outbox ORDER BY id DESC LIMIT 12;"}

spawn ssh -tt $user@$host $remote_command
expect {
    "yes/no" { send "yes\r"; exp_continue }
    -re "(?i)password.*:" { send "$password\r"; exp_continue }
    eof
}
set result [wait]
exit [lindex $result 3]
