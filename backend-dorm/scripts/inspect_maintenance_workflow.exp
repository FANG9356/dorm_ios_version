#!/usr/bin/expect -f

set timeout 30
set maintenance_id [lindex $argv 0]
if {![regexp {^[0-9]+$} $maintenance_id]} {
    puts stderr "usage: inspect_maintenance_workflow.exp MAINTENANCE_ID"
    exit 2
}

set credential_file [file join [file dirname [info script]] .. build_deploy.exp]
set handle [open $credential_file r]
set credential_text [read $handle]
close $handle
if {![regexp {set password "([^"]+)"} $credential_text -> password]} {
    puts stderr "could not read deployment credential"
    exit 2
}

set host "202.29.232.28"
set user "fang"
set query "SELECT id, room_number, issue, status, cost, COALESCE(quote_approved_at,''), last_updated FROM maintenances WHERE id=$maintenance_id;"
set snapshot_query "SELECT s.version, json_extract(j.value,'$.serverId') AS server_id, json_extract(j.value,'$.status') AS status, json_extract(j.value,'$.quoteApprovedAt') AS quote_approved_at FROM sync_snapshots s, json_each(s.payload,'$.maintenance') j WHERE s.account_id=1 AND json_extract(j.value,'$.serverId')=$maintenance_id ORDER BY s.version DESC LIMIT 1;"
set remote_command "sudo sqlite3 -header -column /opt/dormitory/dorm_data/tenant_1.db \"$query\" && sudo sqlite3 -header -column /opt/dormitory/dormitory.db \"$snapshot_query\""

spawn ssh -tt $user@$host $remote_command
expect {
    "yes/no" { send "yes\r"; exp_continue }
    -re "(?i)password.*:" { send "$password\r"; exp_continue }
    eof
}
set result [wait]
exit [lindex $result 3]
