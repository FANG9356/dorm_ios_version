#!/usr/bin/expect -f

set timeout 30
set outbox_id [lindex $argv 0]
if {![regexp {^[0-9]+$} $outbox_id]} {
    puts stderr "usage: retry_line_outbox.exp OUTBOX_ID"
    exit 2
}

set credential_file [file join [file dirname [info script]] .. build_deploy.exp]
set handle [open $credential_file r]
set credential_text [read $handle]
close $handle
if {![regexp {set password "([^"]+)"} $credential_text -> password]} {
    puts stderr "could not read deployment credential"
    exit 2
}

set host "202.29.232.28"
set user "fang"
set remote_command "sudo sqlite3 /opt/dormitory/dormitory.db \"UPDATE line_notification_outbox SET status='pending', next_attempt_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE id=$outbox_id; SELECT changes();\""

spawn ssh -tt $user@$host $remote_command
expect {
    "yes/no" { send "yes\r"; exp_continue }
    -re "(?i)password.*:" { send "$password\r"; exp_continue }
    eof
}
set result [wait]
exit [lindex $result 3]
