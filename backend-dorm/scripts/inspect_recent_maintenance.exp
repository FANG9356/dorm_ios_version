#!/usr/bin/expect -f

set timeout 30
set credential_file [file join [file dirname [info script]] .. build_deploy.exp]
set handle [open $credential_file r]
set credential_text [read $handle]
close $handle
if {![regexp {set password "([^"]+)"} $credential_text -> password]} {
    puts stderr "could not read deployment credential"
    exit 2
}

set host "202.29.232.28"
set user "fang"
set tenant_query "SELECT id, room_number, issue, status, cost, last_updated FROM maintenances ORDER BY id DESC LIMIT 5;"
set snapshot_query "SELECT s.version, s.device_id, json_extract(j.value,'$.serverId') AS server_id, json_extract(j.value,'$.roomNumber') AS room, json_extract(j.value,'$.issue') AS issue, json_extract(j.value,'$.status') AS status FROM sync_snapshots s, json_each(s.payload,'$.maintenance') j WHERE s.account_id=1 AND s.version=(SELECT MAX(version) FROM sync_snapshots WHERE account_id=1) ORDER BY CAST(json_extract(j.value,'$.serverId') AS INTEGER) DESC LIMIT 5;"
set remote_command "sudo sqlite3 -header -column /opt/dormitory/dorm_data/tenant_1.db \"$tenant_query\" && sudo sqlite3 -header -column /opt/dormitory/dormitory.db \"$snapshot_query\""

spawn ssh -tt $user@$host $remote_command
expect {
    "yes/no" { send "yes\r"; exp_continue }
    -re "(?i)password.*:" { send "$password\r"; exp_continue }
    eof
}
set result [wait]
exit [lindex $result 3]
